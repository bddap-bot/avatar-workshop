[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = false

[libraries]
linux.x86_64 = "res://addons/avatar_workshop/bin/linux-x86_64/libavatar_godot.so"
linux.arm64 = "res://addons/avatar_workshop/bin/linux-arm64/libavatar_godot.so"
windows.x86_64 = "res://addons/avatar_workshop/bin/windows-x86_64/avatar_godot.dll"
android.arm64 = "res://addons/avatar_workshop/bin/android-arm64/libavatar_godot.so"
